{
  "name": "instant-dashboard-builder",
  "version": "1.0.0",
  "description": "Serverless Telegram bot that generates ready-to-run Streamlit dashboards via Groq, running on Cloudflare Workers + D1.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:init": "wrangler d1 execute instant-dashboard-db --remote --file=./schema.sql",
    "db:init:local": "wrangler d1 execute instant-dashboard-db --local --file=./schema.sql"
  },
  "dependencies": {
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.90.0"
  }
}
