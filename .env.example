# =========================================================================
#  Instant Dashboard Builder — пример файла окружения
#  Скопируйте этот файл в `.env` и заполните реальными значениями.
#  Файл `.env` НЕ должен попадать в git (см. .gitignore).
# =========================================================================

# --- Telegram ---
# Токен бота, полученный у @BotFather
BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Groq API ---
# Ключ доступа к Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Модель Groq (по умолчанию используется быстрая llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# --- Оплата Premium ---
# Способ оплаты: "stars" — Telegram Stars (по умолчанию), "fiat" — фиатный провайдер.
PAYMENT_PROVIDER=stars

# Токен платёжного провайдера (нужен ТОЛЬКО при PAYMENT_PROVIDER=fiat).
# Для Telegram Stars оставьте пустым.
# Тестовый токен можно получить у @BotFather -> Payments -> подключить провайдера.
PROVIDER_TOKEN=

# Цена подписки Premium.
#   - для "stars": целое число звёзд (например 100)
#   - для "fiat":  сумма в минимальных единицах валюты (центы), например 29900 = 299.00
PREMIUM_PRICE=100

# Валюта для фиатного провайдера (игнорируется для Stars, там всегда XTR)
PREMIUM_CURRENCY=USD

# Срок действия подписки Premium в днях
PREMIUM_DAYS=30

# --- Лимиты и защита ---
# Сколько бесплатных генераций в сутки доступно free-пользователю
FREE_DAILY_LIMIT=3

# Максимальная длина пользовательского запроса (защита от спама)
MAX_PROMPT_LENGTH=1500

# --- База данных ---
# Путь к файлу базы данных SQLite
DB_PATH=bot_database.db
